{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run JavaFX",
            "request": "launch",
            "mainClass": "com.lenguajecafetero.vista.AcademiaApplication",
            "cwd": "${workspaceFolder}",
            "vmArgs": "--module-path ${env:HOME}/.m2/repository/org/openjfx/javafx-controls/21.0.6/javafx-controls-21.0.6-mac.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-graphics/21.0.6/javafx-graphics-21.0.6-mac.jar:${env:HOME}/.m2/repository/org/openjfx/javafx-base/21.0.6/javafx-base-21.0.6-mac.jar --add-modules javafx.controls"
        }
    ]
}
